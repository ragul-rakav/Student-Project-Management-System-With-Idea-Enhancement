# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_projecthub_2026
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_projectpulse_2026

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/student_project_repository
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=student_project_repository

# AI Text Embedding Provider Configuration
# Options: 'local' (deterministic TF-IDF subword vectorizer - no API key needed), 'gemini', or 'openai'
EMBEDDING_PROVIDER=local

# Google Gemini API Key (Required if EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Redis & BullMQ Configuration (Optional - in-process async worker fallback active if omitted)
# REDIS_URL=redis://127.0.0.1:6379
