# Server Configuration
PORT=5000
NODE_ENV=production

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_projecthub_2026
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_projectpulse_2026

# Neon / Cloud PostgreSQL Connection String
# Paste your Neon connection string here (with sslmode=require)
DATABASE_URL=postgresql://user:password@ep-cool-pond-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# CORS & Client Integration (Point to your Vercel URL)
CLIENT_URL=https://your-project.vercel.app
ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:5173

# AI Text Embedding Provider Configuration
# 'local' runs 100% offline with no external API keys required!
EMBEDDING_PROVIDER=local

# Google Gemini API Key (Optional, only if EMBEDDING_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional, only if EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here

# Redis & BullMQ Configuration (Optional - in-process worker active if omitted)
# REDIS_URL=redis://127.0.0.1:6379
